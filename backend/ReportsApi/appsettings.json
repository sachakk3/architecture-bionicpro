{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "Issuer": "http://localhost:8080/realms/reports-realm",
    "MetadataAddress": "http://localhost:8080/realms/reports-realm/.well-known/openid-configuration",
    "RequireHttpsMetadata": false,
    "AllowedClients": [ "reports-frontend" ]
  },
  "ClickHouse": {
    "Url": "http://localhost:8123",
    "User": "reports_api",
    "Password": "reports_api_password"
  },
  "Reports": {
    "DefaultPeriodDays": 30,
    "MaxPeriodDays": 366
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3105" ]
  }
}
